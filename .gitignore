# =============================================================
#  Enterprise Prompt Engineering Toolkit — .gitignore
# =============================================================

# ── Secrets & Environment ────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
secret.txt

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.whl

# ── Python testing / coverage ────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── SQLite (local dev database) ──────────────────────────────
*.db
*.sqlite
*.sqlite3
prompt_toolkit.db

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
.npm
.yarn/
.pnp.*

# Vite / build output
frontend/dist/
frontend/.vite/
dist/
.cache/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
install.log
pip_install.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ── Temp / scripts ───────────────────────────────────────────
install_backend.bat
gen_secret.bat
secret.txt
run_install.ps1
start_backend.bat

# ── Docker ───────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
