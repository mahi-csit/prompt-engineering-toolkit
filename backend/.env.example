# Database — MongoDB Atlas
# Replace with your MongoDB connection string
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=prompt_toolkit

# LLM Provider Keys (Optional)
# The application works with demo models without any API keys
# Uncomment and add keys below if you want to enable external LLM providers
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AQ...
# ANTHROPIC_API_KEY=sk-ant-...

# Security — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters for production
SECRET_KEY=generate-a-strong-random-key-here-at-least-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
